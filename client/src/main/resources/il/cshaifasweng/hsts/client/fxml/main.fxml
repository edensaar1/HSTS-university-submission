<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="il.cshaifasweng.hsts.client.screens.MainMenuScreen">
    <center>
        <VBox alignment="CENTER" maxWidth="350.0" spacing="14.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
            </padding>
            <children>
                <Label text="HSTS Main Menu"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome"/>
                <Label fx:id="roleLabel" text="Role"/>
                <Button fx:id="questionBankButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleQuestionBank"
                        text="Question Bank"/>
                <Button fx:id="examCreationButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleExamCreation"
                        text="Create Exam"/>
                <Button fx:id="examManagementButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleExamManagement"
                        text="Manage Exams"/>
                <Button fx:id="submissionManagementButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleSubmissionManagement"
                        text="Review Submissions"/>
                <Button fx:id="teacherStatisticsButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleTeacherStatistics"
                        text="Exam Statistics"/>
                <Button fx:id="examApprovalButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleExamApproval"
                        text="Approve Exams"/>
                <Button fx:id="examEntryButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleExamEntry"
                        text="Enter Exam"/>
                <Button fx:id="studentResultsButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleStudentResults"
                        text="My Results"/>
                <Button fx:id="logoutButton" maxWidth="300.0"
                        mnemonicParsing="false" onAction="#handleLogout"
                        text="Logout"/>
            </children>
        </VBox>
    </center>
</BorderPane>
