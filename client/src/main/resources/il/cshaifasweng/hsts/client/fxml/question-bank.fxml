<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.hsts.client.screens.QuestionBankScreen">
   <top>
      <VBox prefWidth="100.0" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
                  <Label text="Question Bank" />
                  <Label text="Teacher" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Course" />
                  <ComboBox fx:id="courseComboBox" prefWidth="250.0" />
                  <Button mnemonicParsing="false" onAction="#handleLoadQuestions" text="Load Questions" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="questionsTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="questionIdColumn" prefWidth="120.0" text="Question ID" />
          <TableColumn fx:id="descriptionColumn" prefWidth="430.0" text="Description" />
            <TableColumn fx:id="correctAnswerColumn" prefWidth="120.0" text="Correct Answer" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <right>
      <VBox prefHeight="200.0" prefWidth="430.0" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Question Details" />
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="270.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
              </rowConstraints>
               <children>
                  <Label text="Question ID:" />
                  <Label text="Description:" GridPane.rowIndex="1" />
                  <Label text="Answer 1:" GridPane.rowIndex="2" />
                  <Label text="Answer 2:" GridPane.rowIndex="3" />
                  <Label text="Answer 3:" GridPane.rowIndex="4" />
                  <Label text="Answer 4:" GridPane.rowIndex="5" />
                  <Label text="Correct Answer:" GridPane.rowIndex="6" />
                  <Label text="Illustration Path:" GridPane.rowIndex="7" />
                  <TextField fx:id="questionIdField" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                  <TextArea fx:id="descriptionArea" prefHeight="90.0" prefWidth="270.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="answer1Field" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="answer2Field" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="answer3Field" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <TextField fx:id="answer4Field" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <ComboBox fx:id="correctAnswerComboBox" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  <TextField fx:id="illustrationPathField" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="7" />
               </children>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleCreate" prefWidth="90.0" text="Create" />
                  <Button fx:id="updateButton" mnemonicParsing="false" onAction="#handleUpdate" prefWidth="90.0" text="Update" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" prefWidth="90.0" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#handleChooseIllustration" prefHeight="35.0" prefWidth="108.0" text="Choose Illustration">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <Label fx:id="statusLabel" />
         </children>
         <padding>
            <Insets bottom="15.0" left="10.0" right="15.0" top="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
