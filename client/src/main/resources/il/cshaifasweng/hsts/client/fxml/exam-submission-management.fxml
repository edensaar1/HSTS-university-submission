<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="il.cshaifasweng.hsts.client.screens.ExamSubmissionManagementScreen">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Button text="Back" onAction="#handleBack"/>
            <Label text="Submission Review" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <padding><Insets top="15.0"/></padding>
            <Label text="Submitted Exams" style="-fx-font-weight: bold;"/>
            <TableView fx:id="submissionsTable" prefHeight="220.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="studentColumn" prefWidth="170.0" text="Student"/>
                    <TableColumn fx:id="examIdColumn" prefWidth="90.0" text="Exam ID"/>
                    <TableColumn fx:id="courseColumn" prefWidth="210.0" text="Course"/>
                    <TableColumn fx:id="submittedAtColumn" prefWidth="165.0" text="Submitted At"/>
                    <TableColumn fx:id="automaticGradeColumn" prefWidth="125.0" text="Automatic Grade"/>
                    <TableColumn fx:id="finalGradeColumn" prefWidth="100.0" text="Final Grade"/>
                </columns>
            </TableView>
            <Separator/>
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="selectedSubmissionLabel" text="Select a submission"
                           style="-fx-font-weight: bold;"/>
                    <TableView fx:id="answersTable" prefWidth="720.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="questionIdColumn" prefWidth="85.0" text="Question"/>
                            <TableColumn fx:id="questionTextColumn" prefWidth="210.0" text="Description"/>
                            <TableColumn fx:id="selectedAnswerColumn" prefWidth="150.0" text="Student Answer"/>
                            <TableColumn fx:id="correctAnswerColumn" prefWidth="150.0" text="Correct Answer"/>
                            <TableColumn fx:id="pointsColumn" prefWidth="65.0" text="Points"/>
                            <TableColumn fx:id="resultColumn" prefWidth="85.0" text="Result"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox prefWidth="300.0" spacing="7.0">
                    <Label text="Final Grade"/>
                    <TextField fx:id="finalGradeField" promptText="0-100"/>
                    <Label text="Teacher Comment"/>
                    <TextArea fx:id="teacherCommentArea" prefRowCount="4" wrapText="true"/>
                    <Label text="Grade Change Reason"/>
                    <TextArea fx:id="gradeChangeReasonArea" prefRowCount="4"
                              promptText="Required when changing the automatic grade" wrapText="true"/>
                    <Button fx:id="approveButton" text="Approve Result" onAction="#handleApprove"/>
                    <Label fx:id="statusLabel" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
